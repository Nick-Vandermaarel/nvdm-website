---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div>
  {
    items.map((item) => (
      <span class="my-1 mr-2 inline-block cursor-pointer rounded-full border border-border bg-surface-deep px-4 py-2 text-sm text-copy transition duration-200 hover:-translate-y-0.5 hover:border-accent hover:shadow-[0_10px_24px_rgba(182,146,123,0.18)]">
        {item}
      </span>
    ))
  }
</div>
