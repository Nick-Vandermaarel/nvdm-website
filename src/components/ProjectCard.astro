---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="mb-4 border border-border bg-surface p-6">
  <h3 class="mb-2 text-[1.1rem] font-extrabold text-accent-warm">{title}</h3>
  <div class="space-y-3 text-copy-muted [&_p]:leading-7">
    <slot />
  </div>
</article>
